__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
*.log
_probe/
_xlsx_probe/
tools/*.exe
!tools/smoke_test_products.js
# NOTE: db/files/*.xlsx ARE committed on purpose — they are the master data.

# NKK sir confidential pre-production price DB — keep LOCAL, never publish (Pages is public)
db/pre_production/

# Coverage workbook output — contains NK job values (confidential), never publish
NKK_Products_and_Coverage.xlsx

# Node deps for platform services
platform/**/node_modules/
node_modules/

# runtime rate-card change log (created by the API at runtime)
platform/api/data/rate_card_history.json

# saved customer quotes (created at runtime; may hold customer contact details)
platform/quote-service/data/

# orders + payments (created at runtime; hold customer + payment detail)
platform/order-service/data/

# B1 history index — anonymised but derived from the confidential DB; keep LOCAL, never commit
platform/history-service/data/

# real product photo binaries (served locally; may be large) — keep the JSON map, not the bytes
platform/api/data/photos/
